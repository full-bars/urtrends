[Unit]
Description=URTrends Backend
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/urtrends
ExecStart=/home/user/urtrends/urtrends
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="RUST_LOG=info"

[Install]
WantedBy=multi-user.target
